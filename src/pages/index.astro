---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import type { NoteEntry } from '../content-types';

const notes = (
  (await getCollection('notes')) as unknown as NoteEntry[]
)
  .filter((n) => !n.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<Base>
  <section class="py-14 md:py-20">
    <p class="font-mono text-xs uppercase tracking-[0.18em] text-faint">Berlin, Germany</p>
    <h1 class="mt-4 text-4xl font-semibold leading-[1.05] tracking-[-0.03em] md:text-6xl">
      Hi, I’m Limin.
    </h1>
    <p class="mt-6 max-w-[38ch] text-lg leading-relaxed text-muted">
      I’m a software engineer working on backend systems, optimization, and production
      software. I’m particularly interested in distributed systems, AI infrastructure,
      agent architectures, and performance engineering.
    </p>
  </section>

  <section aria-labelledby="work-h" class="border-t border-line py-10">
    <h2 id="work-h" class="font-mono text-[11px] uppercase tracking-[0.18em] text-faint">
      Selected engineering work
    </h2>
    <div class="mt-5 space-y-6">
      <article>
        <h3 class="text-xl font-semibold tracking-tight">
          <a href="/work" class="hover:text-accent">Production applications for educational products</a>
        </h3>
        <p class="mt-2 max-w-[62ch] leading-relaxed text-muted">
          A production Python application computing optimized combinations of educational
          products, generating schedules and quotations, integrating with a CRM system, and
          creating documents. Anonymized — no proprietary details.
        </p>
        <p class="mt-2 font-mono text-xs text-faint">Python · optimization · enterprise integrations · Azure</p>
      </article>
    </div>
    <p class="mt-6">
      <a href="/work" class="font-mono text-[13px] text-accent underline underline-offset-4">All work →</a>
    </p>
  </section>

  <section aria-labelledby="interests-h" class="border-t border-line py-10">
    <h2 id="interests-h" class="font-mono text-[11px] uppercase tracking-[0.18em] text-faint">
      Technical interests
    </h2>
    <div class="mt-5 grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2">
      <div class="bg-paper-raised p-5">
        <h3 class="font-mono text-xs uppercase tracking-wider text-accent">From practice</h3>
        <ul class="mt-3 space-y-1.5 text-[15px] leading-relaxed">
          <li>Backend architecture for production Python</li>
          <li>Optimization &amp; constraint scheduling</li>
          <li>Enterprise API integrations</li>
          <li>Reliability &amp; production debugging</li>
        </ul>
      </div>
      <div class="bg-paper-raised p-5">
        <h3 class="font-mono text-xs uppercase tracking-wider text-accent">Currently exploring</h3>
        <ul class="mt-3 space-y-1.5 text-[15px] leading-relaxed">
          <li>Agent architectures &amp; execution runtimes</li>
          <li>Durable execution &amp; fault tolerance</li>
          <li>Model serving &amp; inference scheduling</li>
          <li>Observability &amp; AI system evaluation</li>
        </ul>
      </div>
    </div>
  </section>

  <section aria-labelledby="notes-h" class="border-t border-line py-10">
    <h2 id="notes-h" class="font-mono text-[11px] uppercase tracking-[0.18em] text-faint">
      Recent notes
    </h2>
    {
      notes.length === 0 ? (
        <p class="mt-5 max-w-[62ch] leading-relaxed text-muted">
          No notes yet. This will become a technical notebook — investigations, experiments,
          and research notes, published when they have something to say.
        </p>
      ) : (
        <ul class="mt-5 space-y-4">
          {notes.map((n: NoteEntry) => (
            <li>
              <a href={`/notes/${n.id}`} class="text-lg font-medium tracking-tight hover:text-accent">
                {n.data.title}
              </a>
              <p class="mt-1 font-mono text-xs text-faint">
                {n.data.date.toISOString().slice(0, 10)}
                {n.data.tags.length > 0 && ` · ${n.data.tags.join(', ')}`}
              </p>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>
