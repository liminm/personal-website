---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import type { NoteEntry } from '../content-types';

const notes = ((await getCollection('notes')) as unknown as NoteEntry[]).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Base
  title="Notes — Limin Malek"
  description="Technical notebook: investigations, experiments, and research notes on systems and AI infrastructure."
>
  <section class="py-12">
    <p class="font-mono text-xs uppercase tracking-[0.18em] text-faint">Notes</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-[-0.02em] md:text-5xl">
      Technical notebook.
    </h1>
    <p class="mt-5 max-w-[62ch] leading-relaxed text-muted">
      Investigations, experiments, and research notes. Published when they have
      something substantive to say — no filler.
    </p>
  </section>

  <section aria-label="Notes index" class="border-t border-line py-8">
    {
      notes.length === 0 ? (
        <p class="max-w-[62ch] leading-relaxed text-muted">
          Nothing here yet. The first notes will likely cover durable execution for AI
          agents, Python concurrency, or constraint programming for scheduling — written
          from real investigation, not proposed from a topic list.
        </p>
      ) : (
        <ul class="space-y-6">
          {notes.map((n) => (
            <li>
              <a href={`/notes/${n.id}`} class="text-xl font-medium tracking-tight hover:text-accent">
                {n.data.title}
              </a>
              <p class="mt-1 max-w-[62ch] text-muted">{n.data.description}</p>
              <p class="mt-1 font-mono text-xs text-faint">
                {n.data.date.toISOString().slice(0, 10)}
                {n.data.tags.length > 0 && ` · ${n.data.tags.join(', ')}`}
              </p>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>
