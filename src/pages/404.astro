---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — Limin Malek" description="The page you seek does not exist.">
  <section class="py-20">
    <p class="font-mono text-xs uppercase tracking-[0.18em] text-faint">404</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-[-0.02em]">Page not found.</h1>
    <p class="mt-4 text-muted">The page you seek does not exist.</p>
    <p class="mt-6">
      <a href="/" class="font-mono text-[13px] text-accent underline underline-offset-4">Back to home →</a>
    </p>
  </section>
</Base>
