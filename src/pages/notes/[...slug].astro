---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import type { NoteEntry, TocHeading } from '../../content-types';

type RawEntry = Record<string, unknown> & { id: string; data: NoteEntry['data'] };
type RenderInput = Parameters<typeof render>[0];

export async function getStaticPaths() {
  const entries = ((await getCollection('notes')) as unknown as RawEntry[]).filter(
    (e) => !e.data.draft,
  );
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: RawEntry };
const { Content, headings } = await render(entry as unknown as RenderInput);
const toc = (headings as unknown as TocHeading[]).filter((h) => h.depth <= 3);
---

<Base title={`${entry.data.title} — Limin Malek`} description={entry.data.description} ogType="article">
  <article class="py-12">
    <p class="font-mono text-xs uppercase tracking-[0.18em] text-faint">
      <a href="/notes" class="hover:text-ink">Notes</a>
    </p>
    <h1 class="mt-3 max-w-[24ch] text-3xl font-semibold tracking-[-0.02em] md:text-4xl">
      {entry.data.title}
    </h1>
    <p class="mt-3 max-w-[62ch] leading-relaxed text-muted">{entry.data.description}</p>
    <p class="mt-3 font-mono text-xs text-faint">
      {entry.data.date.toISOString().slice(0, 10)}
      {entry.data.tags.length > 0 && ` · ${entry.data.tags.join(', ')}`}
    </p>
    {
      toc.length >= 3 && (
        <nav aria-label="Table of contents" class="mt-8 rounded-xl border border-line bg-paper-raised p-5">
          <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-faint">Contents</p>
          <ul class="mt-3 space-y-1.5 text-[15px]">
            {toc.map((h: TocHeading) => (
              <li class:list={[{ 'pl-5': h.depth === 3 }]}>
                <a href={`#${h.slug}`} class="text-muted hover:text-accent">
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    <div class="mdx-body mt-8"><Content /></div>
  </article>
</Base>
